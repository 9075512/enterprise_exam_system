{
  "name": "enterprise_exam_system",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "企业内部在线考试系统（Vue 3 + Element Plus 前端 / Node.js + MySQL 后端）",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vue-tsc --noEmit && vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm --prefix server run test",
    "db:init": "npm --prefix server run db:init"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.64.5",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.1.2",
    "sass": "^1.80.6",
    "typescript": "^5.5.0",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
