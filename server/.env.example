# 服务端口
PORT=3001
APP_RELEASES_DIR=storage/app-releases

# MySQL 连接配置（口令仅从 .env 注入，严禁硬编码/提交）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=enterprise_exam_system
DB_NAME_TEST=enterprise_exam_system_test

# JWT 配置
JWT_SECRET=
JWT_EXPIRES_IN=12h

# 富文本附件本地对象存储根目录（v1.8④ U4；相对路径以 server 根目录为锚点）
STORAGE_DIR=storage/attachments

# ============================================================
# 练题（增量 · 公网练题模块，架构 §10-20）
# 说明：均可留空使用默认值；生产（尤其公网实例）务必显式设置两个 SECRET。
# ============================================================
# 内网实例是否注册练题路由（默认 true，便于联调）
ENABLE_PRACTICE=true
# true=仅装配练题路由（方案乙公网练题实例；考试/用户/报表路由不注册，物理不可达）
PRACTICE_ONLY=false
# 方案甲：Nginx 注入 X-Internal-Key 的共享密钥；空=不启用边界兜底
PRACTICE_EDGE_SECRET=
# 练题登录 JWT secret（独立于内网 JWT_SECRET；缺省由内网密钥派生）
PRACTICE_JWT_SECRET=
# 练题登录 JWT 有效期
PRACTICE_JWT_EXPIRES_IN=12h
# 无状态 sessionToken 签名密钥（缺省由内网密钥派生）
PRACTICE_SESSION_SECRET=
# 练习会话有效期（秒）
PRACTICE_SESSION_TTL=1800
# 业务时区偏移（每日一练自然日 / 连续打卡 / 逐日报告）；格式 ±HH:MM，默认 +08:00
PRACTICE_TZ_OFFSET=+08:00
# 登录失败锁定阈值（次数）
PRACTICE_LOGIN_MAX_FAILS=5
# 锁定时长（分钟）
PRACTICE_LOGIN_LOCK_MINUTES=15
# check 每设备每分钟上限
PRACTICE_RATE_CHECK_PER_MIN=60
# 题库列表/题目每设备每分钟上限
PRACTICE_RATE_BANKS_PER_MIN=30
# 生成练习会话每设备每分钟上限（含 RAND() 且签发 token，重点限流）
PRACTICE_RATE_SESSION_PER_MIN=20
# 进度读写每设备每分钟上限
PRACTICE_RATE_PROGRESS_PER_MIN=60
# 错题本读写每设备每分钟上限
PRACTICE_RATE_WRONGBOOK_PER_MIN=60
# 收藏夹读写每设备每分钟上限
PRACTICE_RATE_FAVORITES_PER_MIN=60
# 学习报告查询每设备每分钟上限
PRACTICE_RATE_REPORT_PER_MIN=60
# 每日一练读写每设备每分钟上限
PRACTICE_RATE_DAILY_PER_MIN=60
# 登录每设备每分钟上限
PRACTICE_RATE_LOGIN_PER_MIN=10
# 方案乙：最小权限 DB 账号（若独立部署练题实例时使用；缺省复用 DB_USER）
# PRACTICE_DB_USER=practice_app
# PRACTICE_DB_PASSWORD=

