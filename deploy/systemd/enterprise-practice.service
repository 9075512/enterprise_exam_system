[Unit]
Description=Enterprise Exam Practice-only API
After=network.target mysql.service

[Service]
Type=simple
User=examapp
Group=examapp
WorkingDirectory=/opt/enterprise-exam/current/server
EnvironmentFile=/opt/enterprise-exam/shared/practice.env
ExecStart=/usr/local/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
